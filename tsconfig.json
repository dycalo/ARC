{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "packages",
    "outDir": "dist"
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["**/tests/**", "node_modules", "dist"]
}
