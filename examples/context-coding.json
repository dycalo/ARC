    "includeReasoning": true,
    "maxBytes": 16384,
    "ttlSteps": 128,
    "excerpt": "head-tail"
  },
  "requireNativeRequirements": false,
  "recentActivityLimit": 4,
  "incompleteResponseRetries": 0,
  "nativeHistorySteps": 8
}
