{
  "nativeMode": "declarative-tools",
  "checkpointEveryNativeSteps": 0,
  "runtime": {
    "horizon": 4,
    "refreshPolicy": "adaptive",
    "optionalEvidence": "adaptive",
    "materializationAttempts": 2,
    "maxActiveRequirements": 128,
    "maxMemoryEntries": 256,
    "viewFormat": "text-v2",
    "maxOptionalRecords": 64,
    "viewBudgetBytes": 262144
  },
  "maxRequestBytes": 258048,
